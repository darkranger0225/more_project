<view class="container">
  <!-- 班级信息 -->
  <view class="class-info-card">
    <view class="class-header">
      <text class="class-name">{{classInfo.className}}</text>
      <text class="grade-tag">{{classInfo.grade}}</text>
    </view>
    <view class="class-detail">
      <text class="detail-item" wx:if="{{classInfo.headTeacherName}}">班主任: {{classInfo.headTeacherName}}</text>
      <text class="detail-item" wx:if="{{classInfo.description}}">{{classInfo.description}}</text>
    </view>
    <view class="class-stats">
      <view class="stats-item">
        <text class="stats-number">{{studentList.length}}</text>
        <text class="stats-label">学生</text>
      </view>
    </view>
  </view>

  <!-- 学生列表 -->
  <view class="student-section">
    <view class="section-header">
      <text class="section-title">学生列表</text>
    </view>
    
    <view class="student-list">
      <block wx:if="{{studentList.length > 0}}">
        <view class="student-item" wx:for="{{studentList}}" wx:key="id">
          <view class="student-avatar">
            <text class="avatar-text">{{item.studentName[0]}}</text>
          </view>
          <view class="student-info">
            <text class="student-name">{{item.studentName}}</text>
            <text class="student-no" wx:if="{{item.studentNo}}">学号: {{item.studentNo}}</text>
          </view>
          <view class="student-extra">
            <text class="gender-tag" wx:if="{{item.gender !== null}}">{{item.gender === 1 ? '男' : '女'}}</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="empty-state">
          <text class="empty-text">暂无学生</text>
        </view>
      </block>
    </view>
  </view>
</view>
