.container {
  padding: 24rpx;
  background: #f8f9fa;
  min-height: 100vh;
}

.class-info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.class-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.class-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.grade-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  background: #e3f2fd;
  color: #1976d2;
  border-radius: 8rpx;
}

.class-detail {
  margin-bottom: 20rpx;
}

.detail-item {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
  text-align: center;
}

.class-stats {
  display: flex;
  justify-content: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #4CAF50;
}

.stats-label {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.student-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.student-list {
  margin-top: 8rpx;
}

.student-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.student-item:last-child {
  border-bottom: none;
}

.student-avatar {
  width: 80rpx;
  height: 80rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.student-no {
  font-size: 24rpx;
  color: #999;
}

.student-extra {
  display: flex;
  align-items: center;
}

.gender-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 8rpx;
}

.empty-state {
  padding: 80rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
