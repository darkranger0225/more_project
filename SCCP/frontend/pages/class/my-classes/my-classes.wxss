.container {
  padding: 24rpx;
  background: #f8f9fa;
  min-height: 100vh;
}

.class-list {
  margin-top: 8rpx;
}

.class-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.class-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.class-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.grade-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #e3f2fd;
  color: #1976d2;
  border-radius: 8rpx;
}

.class-info {
  margin-bottom: 20rpx;
}

.info-item {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.class-stats {
  display: flex;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stats-item {
  font-size: 26rpx;
  color: #4CAF50;
  background: #e8f5e9;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #ccc;
}
