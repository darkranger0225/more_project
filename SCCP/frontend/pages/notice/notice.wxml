<view class="container">
  <!-- 角色切换标签（管理员和教师显示） -->
  <view class="role-tabs" wx:if="{{role === 'ADMIN' || role === 'TEACHER'}}">
    <view class="tab {{activeTab === 'receive' ? 'active' : ''}}" bindtap="switchTab" data-tab="receive">收到的通知</view>
    <view class="tab {{activeTab === 'send' ? 'active' : ''}}" bindtap="switchTab" data-tab="send">发送的通知</view>
  </view>

  <!-- 通知列表 -->
  <view class="notice-list">
    <view class="notice-item {{item.isRead ? 'read' : 'unread'}}" wx:for="{{notices}}" wx:key="id" bindtap="viewNoticeDetail" data-id="{{item.id}}">
      <view class="notice-header">
        <view class="notice-title">
          <text class="priority-tag" wx:if="{{item.priority === 1}}">重要</text>
          <text class="title-text">{{item.title}}</text>
        </view>
        <view class="unread-dot" wx:if="{{!item.isRead}}"></view>
      </view>
      <view class="notice-content">{{item.content}}</view>
      <view class="notice-footer">
        <text class="publisher">发布人：{{item.publisherName}}</text>
        <text class="time">{{item.createTime}}</text>
      </view>
      <view class="target-info" wx:if="{{item.targetType !== 'ALL'}}">
        <text class="target-type">{{item.targetTypeName}}</text>
        <text class="target-names" wx:if="{{item.targetNames}}">{{item.targetNames}}</text>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{notices.length === 0}}">
      <text class="empty-text">暂无通知</text>
    </view>
  </view>

  <!-- 发布通知按钮（管理员和教师显示） -->
  <view class="fab-btn" wx:if="{{role === 'ADMIN' || role === 'TEACHER'}}" bindtap="goToPublish">
    <text class="fab-icon">+</text>
  </view>
</view>
