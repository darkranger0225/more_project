.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
  padding-bottom: 160rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.required {
  color: #f44336;
}

.input {
  font-size: 30rpx;
  color: #333;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
}

.textarea {
  font-size: 30rpx;
  color: #333;
  height: 300rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  width: calc(100% - 40rpx);
}

.word-count {
  font-size: 24rpx;
  color: #999;
  text-align: right;
  display: block;
  margin-top: 10rpx;
}

.picker {
  font-size: 30rpx;
  color: #333;
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  background: #fff;
}

.picker.priority-high {
  color: #f44336;
  border-color: #f44336;
}

/* 选择列表 */
.select-list {
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.select-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
}

.select-item:last-child {
  border-bottom: none;
}

.select-item.selected {
  background: #e3f2fd;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.check-icon {
  font-size: 32rpx;
  color: #1976d2;
  font-weight: bold;
}

.selected-count {
  font-size: 26rpx;
  color: #1976d2;
  margin-top: 16rpx;
  text-align: right;
}

/* 底部按钮 */
.btn-group {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #e0e0e0;
}

.btn-group .btn {
  flex: 1;
  margin: 0 10rpx;
}

.btn-default {
  background: #f5f5f5;
  color: #666;
}

.btn-primary {
  background: #1976d2;
  color: #fff;
}
