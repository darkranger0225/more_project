.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #b4e2b6 0%, #1c497c 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
  margin-top: 60rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  background: #fff;
  border-radius: 40rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.login-form {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.form-item {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 30rpx;
}

.icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.login-btn {
  margin-top: 40rpx;
  width: 100%;
}

.login-options {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  padding: 0 10rpx;
}

.login-footer {
  margin-top: auto;
  padding-top: 60rpx;
}