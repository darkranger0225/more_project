<view class="forgot-container">
  <view class="forgot-header">
    <text class="title">忘记密码</text>
    <text class="subtitle">重置您的密码</text>
  </view>

  <view class="forgot-form">
    <!-- 步骤1：验证用户名和手机号 -->
    <block wx:if="{{step === 1}}">
      <view class="form-item">
        <text class="icon">👤</text>
        <input 
          type="text" 
          placeholder="请输入用户名" 
          value="{{username}}"
          bindinput="onUsernameInput"
          class="form-input"
        />
      </view>

      <view class="form-item">
        <text class="icon">📱</text>
        <input 
          type="number" 
          placeholder="请输入手机号" 
          value="{{phone}}"
          bindinput="onPhoneInput"
          class="form-input"
          maxlength="11"
        />
      </view>

      <button class="btn btn-primary" bindtap="verifyUser">下一步</button>
    </block>

    <!-- 步骤2：设置新密码 -->
    <block wx:if="{{step === 2}}">
      <view class="verify-success">
        <text class="success-icon">✅</text>
        <text class="success-text">身份验证成功</text>
      </view>

      <view class="form-item">
        <text class="icon">🔒</text>
        <input 
          type="password" 
          placeholder="请输入新密码" 
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
          class="form-input"
        />
      </view>

      <view class="form-item">
        <text class="icon">🔒</text>
        <input 
          type="password" 
          placeholder="请确认新密码" 
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
          class="form-input"
        />
      </view>

      <button class="btn btn-primary" bindtap="resetPassword">重置密码</button>
    </block>

    <view class="login-link">
      <text class="text-muted">想起密码了？</text>
      <text class="text-primary" bindtap="goToLogin">返回登录</text>
    </view>
  </view>
</view>