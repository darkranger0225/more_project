<view class="container">
  <!-- 用户信息卡片 -->
  <view class="profile-card">
    <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
    <text class="user-name">{{userInfo.realName || '用户'}}</text>
    <text class="user-role">{{roleText}}</text>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-list">
    <!-- 管理员专属功能 -->
    <view class="menu-section" wx:if="{{role === 'ADMIN'}}">
      <view class="section-title">系统管理</view>
      <view class="menu-item" bindtap="goToUserManage">
        <text class="menu-icon">👥</text>
        <text class="menu-text">用户管理</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToClassManage">
        <text class="menu-icon">🏫</text>
        <text class="menu-text">班级管理</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToStudentManage">
        <text class="menu-icon">👨‍🎓</text>
        <text class="menu-text">学生管理</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <!-- 家长专属功能 -->
    <view class="menu-item" bindtap="goToMyStudents" wx:if="{{role === 'PARENT'}}">
      <text class="menu-icon">👶</text>
      <text class="menu-text">我的孩子</text>
      <text class="menu-arrow">></text>
    </view>
    
    <!-- 教师专属功能 -->
    <view class="menu-item" bindtap="goToMyClasses" wx:if="{{role === 'TEACHER'}}">
      <text class="menu-icon">📚</text>
      <text class="menu-text">我的班级</text>
      <text class="menu-arrow">></text>
    </view>

    <!-- 通用功能 -->
    <view class="menu-section">
      <view class="section-title" wx:if="{{role === 'ADMIN'}}">个人设置</view>
      <view class="menu-item" bindtap="changePassword">
        <text class="menu-icon">🔐</text>
        <text class="menu-text">修改密码</text>
        <text class="menu-arrow">></text>
      </view>

      <view class="menu-item" bindtap="clearCache">
        <text class="menu-icon">🗑️</text>
        <text class="menu-text">清除缓存</text>
        <text class="menu-arrow">></text>
      </view>

      <view class="menu-item" bindtap="aboutUs">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <button class="btn btn-danger logout-btn" bindtap="logout">退出登录</button>
</view>