.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.score-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.score-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.exam-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.exam-date {
  font-size: 24rpx;
  color: #999;
}

.subject-score {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.subject {
  font-size: 28rpx;
  color: #666;
}

.score {
  font-size: 40rpx;
  font-weight: 600;
}

.score.pass {
  color: #4CAF50;
}

.score.fail {
  color: #f44336;
}

.empty-state {
  padding: 100rpx 0;
  text-align: center;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}