.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.score-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.score-header {
  text-align: center;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.exam-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.exam-date {
  font-size: 28rpx;
  color: #999;
}

.score-main {
  text-align: center;
  padding: 40rpx 0;
}

.subject {
  font-size: 32rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.score-value {
  font-size: 80rpx;
  font-weight: 700;
}

.score-value.pass {
  color: #4CAF50;
}

.score-value.fail {
  color: #f44336;
}

.score-info {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.comment-section {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.comment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.comment-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}
