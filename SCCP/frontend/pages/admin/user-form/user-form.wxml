<view class="container">
  <view class="form-card">
    <!-- 用户名 -->
    <view class="form-item">
      <text class="label">用户名 <text class="required">*</text></text>
      <input 
        type="text" 
        placeholder="请输入用户名（至少3位）" 
        value="{{username}}"
        bindinput="onUsernameInput"
        class="input"
        disabled="{{isEdit}}"
      />
    </view>

    <!-- 密码 -->
    <view class="form-item" wx:if="{{!isEdit}}">
      <text class="label">密码 <text class="required">*</text></text>
      <input 
        type="password" 
        placeholder="请输入密码（至少6位）" 
        value="{{password}}"
        bindinput="onPasswordInput"
        class="input"
      />
    </view>

    <!-- 真实姓名 -->
    <view class="form-item">
      <text class="label">真实姓名 <text class="required">*</text></text>
      <input 
        type="text" 
        placeholder="请输入真实姓名" 
        value="{{realName}}"
        bindinput="onRealNameInput"
        class="input"
      />
    </view>

    <!-- 手机号 -->
    <view class="form-item">
      <text class="label">手机号</text>
      <input 
        type="number" 
        placeholder="请输入手机号" 
        value="{{phone}}"
        bindinput="onPhoneInput"
        class="input"
        maxlength="11"
      />
    </view>

    <!-- 角色选择 -->
    <view class="form-item">
      <text class="label">角色 <text class="required">*</text></text>
      <picker bindchange="onRoleChange" value="{{roleIndex}}" range="{{roleArray}}">
        <view class="picker {{role ? '' : 'placeholder'}}">
          {{role ? roleArray[roleIndex] : '请选择角色'}}
        </view>
      </picker>
    </view>

    <!-- 状态选择 -->
    <view class="form-item">
      <text class="label">状态</text>
      <picker bindchange="onStatusChange" value="{{statusIndex}}" range="{{statusArray}}">
        <view class="picker">
          {{statusArray[statusIndex]}}
        </view>
      </picker>
    </view>
  </view>

  <button class="btn btn-primary save-btn" bindtap="saveUser">{{isEdit ? '保存修改' : '添加用户'}}</button>
</view>