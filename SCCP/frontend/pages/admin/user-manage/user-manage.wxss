.container {
  padding: 24rpx;
  background: #f8f9fa;
  min-height: 100vh;
}

/* 顶部操作栏 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-wrapper {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.filter-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 12rpx;
}

.filter-picker {
  display: flex;
  align-items: center;
}

.filter-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.filter-arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.add-icon {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.add-text {
  font-size: 28rpx;
}

/* 统计信息 */
.stats-section {
  display: flex;
  margin-bottom: 24rpx;
}

.stat-item {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

/* 用户列表 */
.user-list {
  margin-top: 8rpx;
}

/* 用户卡片 */
.user-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.user-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 左侧：头像和信息 */
.user-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-content {
  flex: 1;
  min-width: 0;
}

.user-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.role-tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.role-PARENT {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  color: #1976d2;
}

.role-TEACHER {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
  color: #7b1fa2;
}

.role-ADMIN {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  color: #f57c00;
}

.user-info-row {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  margin-bottom: 8rpx;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666;
}

/* 右侧：状态和操作 */
.user-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.status-badge {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.status-1 {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  color: #2e7d32;
}

.status-0 {
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
  color: #c62828;
}

.action-buttons {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.9);
}

.action-btn.edit {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
}

.action-btn.toggle {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
}

.action-btn.delete {
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
}

.action-icon {
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-tip {
  font-size: 26rpx;
  color: #ccc;
}