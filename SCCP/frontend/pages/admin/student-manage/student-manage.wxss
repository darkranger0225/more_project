.container {
  padding: 24rpx;
  background: #f8f9fa;
  min-height: 100vh;
}

.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.add-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.add-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.student-list {
  margin-top: 8rpx;
}

.student-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.student-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.student-content {
  flex: 1;
  min-width: 0;
}

.student-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.student-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.gender-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.gender-1 {
  background: #e3f2fd;
  color: #1976d2;
}

.gender-0 {
  background: #fce4ec;
  color: #c2185b;
}

.student-info-row {
  display: flex;
  flex-direction: column;
}

.info-item {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.student-actions {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  text-align: center;
}

.action-btn:last-child {
  margin-bottom: 0;
}

.action-btn.edit {
  color: #4CAF50;
  background: #e8f5e9;
}

.action-btn.delete {
  color: #f44336;
  background: #ffebee;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #ccc;
}