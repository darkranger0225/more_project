.container { padding: 30rpx; background: #f5f5f5; min-height: 100vh; }
.form-card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 40rpx; }
.form-item { display: flex; flex-direction: column; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.form-item:last-child { border-bottom: none; }
.label { font-size: 28rpx; color: #333; margin-bottom: 16rpx; font-weight: 500; }
.required { color: #f44336; }
.input { font-size: 30rpx; color: #333; height: 60rpx; text-align: center; }
.picker { font-size: 30rpx; color: #333; height: 60rpx; line-height: 60rpx; }
.picker.placeholder { color: #999; }
.textarea { font-size: 30rpx; color: #333; height: 200rpx; width: 100%; }
.word-count { font-size: 24rpx; color: #999; text-align: right; margin-top: 10rpx; }
.save-btn { width: 100%; }

/* 任课教师管理样式 */
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; }
.header-spacer { flex: 1; }
.btn-small { font-size: 24rpx; padding: 10rpx 20rpx; margin-left: 20rpx; }
.teacher-list { margin-top: 20rpx; }
.teacher-item { display: flex; align-items: center; padding: 20rpx; background: #f8f9fa; border-radius: 8rpx; margin-bottom: 16rpx; }
.teacher-name { font-size: 28rpx; color: #333; flex: 1; }
.teacher-subject { font-size: 24rpx; color: #1976d2; background: #e3f2fd; padding: 6rpx 16rpx; border-radius: 8rpx; margin-right: 20rpx; }
.delete-btn { font-size: 26rpx; color: #f44336; padding: 10rpx 20rpx; }
.empty-tip { text-align: center; padding: 40rpx; color: #999; font-size: 28rpx; }