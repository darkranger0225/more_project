<view class="container">
  <view class="form-card">
    <view class="form-item">
      <text class="label">班级名称 <text class="required">*</text></text>
      <input type="text" placeholder="如：一年级1班" value="{{className}}" bindinput="onClassNameInput" class="input" />
    </view>
    <view class="form-item">
      <text class="label">年级 <text class="required">*</text></text>
      <picker bindchange="onGradeChange" value="{{gradeIndex}}" range="{{gradeArray}}">
        <view class="picker {{grade ? '' : 'placeholder'}}">{{grade || '请选择年级'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">班主任</text>
      <picker bindchange="onTeacherChange" value="{{teacherIndex}}" range="{{teacherArray}}" range-key="realName">
        <view class="picker {{headTeacherId ? '' : 'placeholder'}}">{{selectedTeacher ? selectedTeacher.realName : '请选择班主任（可选）'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">班级描述</text>
      <textarea placeholder="请输入班级描述（可选）" value="{{description}}" bindinput="onDescriptionInput" class="textarea" maxlength="200" />
      <text class="word-count">{{description.length}}/200</text>
    </view>
  </view>

  <!-- 任课教师管理（仅编辑模式显示） -->
  <view class="form-card" wx:if="{{isEdit}}">
    <view class="section-header">
      <text class="section-title">任课教师</text>
      <view class="header-spacer"></view>
      <button class="btn btn-small btn-primary" bindtap="showAssignTeacher">添加教师</button>
    </view>
    <view class="teacher-list" wx:if="{{classTeachers.length > 0}}">
      <view class="teacher-item" wx:for="{{classTeachers}}" wx:key="id">
        <text class="teacher-name">{{item.teacherName}}</text>
        <text class="teacher-subject" wx:if="{{item.subject}}">{{item.subject}}</text>
        <text class="delete-btn" bindtap="removeTeacher" data-id="{{item.id}}">删除</text>
      </view>
    </view>
    <view class="empty-tip" wx:else>
      <text>暂无任课教师</text>
    </view>
  </view>

  <button class="btn btn-primary save-btn" bindtap="saveClass">{{isEdit ? '保存修改' : '添加班级'}}</button>
</view>