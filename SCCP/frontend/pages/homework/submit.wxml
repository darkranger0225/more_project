<view class="container">
  <view class="homework-info">
    <text class="info-label">作业标题</text>
    <text class="info-value">{{homeworkTitle}}</text>
  </view>

  <!-- 选择孩子 -->
  <view class="form-item" wx:if="{{studentList.length > 1}}">
    <text class="form-label">选择孩子 <text class="required">*</text></text>
    <picker bindchange="onStudentChange" value="{{studentIndex}}" range="{{studentList}}" range-key="studentName">
      <view class="picker {{selectedStudent ? '' : 'placeholder'}}">
        {{selectedStudent ? selectedStudent.studentName : '请选择孩子'}}
      </view>
    </picker>
  </view>
  <view class="form-item" wx:elif="{{studentList.length === 1}}">
    <text class="form-label">提交人</text>
    <text class="student-name">{{studentList[0].studentName}}</text>
  </view>

  <view class="upload-section">
    <text class="section-title">上传作业图片</text>
    <text class="section-tip">最多可上传9张图片</text>
    
    <view class="image-list">
      <view class="image-item" wx:for="{{images}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}"/>
        <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
      </view>
      
      <view class="upload-btn" wx:if="{{images.length < 9}}" bindtap="chooseImage">
        <text class="upload-icon">+</text>
        <text class="upload-text">添加图片</text>
      </view>
    </view>
  </view>

  <view class="content-section">
    <text class="section-title">作业说明（可选）</text>
    <textarea 
      class="content-input"
      placeholder="请输入作业说明..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="500"
    />
    <text class="word-count">{{content.length}}/500</text>
  </view>

  <button class="btn btn-primary submit-btn" bindtap="submitHomework">提交作业</button>
</view>
