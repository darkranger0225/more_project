.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.homework-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.homework-header {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.subject-tag {
  display: inline-block;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  background: #e3f2fd;
  color: #1976d2;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.homework-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.homework-meta {
  margin-bottom: 30rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.meta-label {
  font-size: 28rpx;
  color: #999;
  width: 140rpx;
}

.meta-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.meta-value.expired {
  color: #f44336;
}

.status-text {
  font-size: 28rpx;
  line-height: 28rpx;
  display: inline-block;
  vertical-align: middle;
}

.status-1 {
  color: #4CAF50;
}

.status-0 {
  color: #999;
}

.content-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.homework-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

.submit-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.submit-card {
  margin-top: 20rpx;
}

.submit-info {
  display: flex;
  margin-bottom: 16rpx;
}

.submit-label {
  font-size: 28rpx;
  color: #999;
  width: 160rpx;
}

.submit-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.submit-score {
  font-size: 32rpx;
  color: #4CAF50;
  font-weight: 600;
}

.submit-images {
  margin-top: 20rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.image-list image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.attachment-section {
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.attachment-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.attachment-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.attachment-name {
  font-size: 28rpx;
  color: #1976d2;
}

.action-section {
  margin-top: 40rpx;
}

.submit-btn {
  width: 100%;
}
