.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.action-bar {
  margin-bottom: 20rpx;
}

.homework-list {
  margin-top: 10rpx;
}

.homework-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.homework-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.homework-title-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  margin-right: 20rpx;
}

.subject-tag {
  background: #e3f2fd;
  color: #1976d2;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  font-weight: 500;
}

.homework-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  line-height: 1.2;
}

.status-1 {
  background: #e8f5e9;
  color: #4CAF50;
}

.status-2 {
  background: #f5f5f5;
  color: #999;
}

.homework-content {
  margin-bottom: 20rpx;
}

.homework-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.homework-meta {
  display: flex;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
  margin-right: 30rpx;
}

.homework-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.deadline {
  display: flex;
  align-items: center;
}

.deadline-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.deadline-time {
  font-size: 24rpx;
  color: #ff9800;
}

.deadline-time.expired {
  color: #f44336;
}

.submit-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  line-height: 1.2;
}

.submit-status.unsubmit {
  background: #ffebee;
  color: #f44336;
}

.submit-status.submitted {
  background: #e8f5e9;
  color: #4CAF50;
}

.submit-count {
  font-size: 24rpx;
  color: #666;
}

.empty-state {
  padding: 100rpx 0;
  text-align: center;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}