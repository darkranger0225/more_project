<view class="container">
  <view class="form-card">
    <!-- 作业标题 -->
    <view class="form-item">
      <text class="label">作业标题 <text class="required">*</text></text>
      <input 
        type="text" 
        placeholder="请输入作业标题" 
        value="{{title}}"
        bindinput="onTitleInput"
        class="input"
      />
    </view>

    <!-- 科目 -->
    <view class="form-item">
      <text class="label">科目 <text class="required">*</text></text>
      <picker bindchange="onSubjectChange" value="{{subjectIndex}}" range="{{subjectArray}}">
        <view class="picker {{subject ? '' : 'placeholder'}}">
          {{subject || '请选择科目'}}
        </view>
      </picker>
    </view>

    <!-- 班级 -->
    <view class="form-item">
      <text class="label">布置班级 <text class="required">*</text></text>
      <picker bindchange="onClassChange" value="{{classIndex}}" range="{{classArray}}" range-key="className">
        <view class="picker {{selectedClass ? '' : 'placeholder'}}">
          {{selectedClass ? selectedClass.className : '请选择班级'}}
        </view>
      </picker>
    </view>

    <!-- 截止时间 -->
    <view class="form-item">
      <text class="label">截止时间 <text class="required">*</text></text>
      <picker mode="multiSelector" bindchange="onDeadlineChange" bindcolumnchange="onDeadlineColumnChange" value="{{deadlineIndex}}" range="{{deadlineArray}}">
        <view class="picker {{deadline ? '' : 'placeholder'}}">
          {{deadline || '请选择截止时间'}}
        </view>
      </picker>
    </view>

    <!-- 作业内容 -->
    <view class="form-item">
      <text class="label">作业内容 <text class="required">*</text></text>
      <textarea 
        placeholder="请输入作业内容" 
        value="{{content}}"
        bindinput="onContentInput"
        class="textarea"
        maxlength="1000"
      />
      <text class="word-count">{{content.length}}/1000</text>
    </view>
  </view>

  <button class="btn btn-primary save-btn" bindtap="publishHomework">发布作业</button>
</view>
