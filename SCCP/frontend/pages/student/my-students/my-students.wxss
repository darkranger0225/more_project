.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.action-bar {
  margin-bottom: 20rpx;
}

.student-list {
  margin-top: 10rpx;
}

.student-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.student-info {
  flex: 1;
}

.student-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.student-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-right: 20rpx;
}

.student-no {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.student-detail {
  display: flex;
  flex-wrap: wrap;
}

.detail-item {
  font-size: 26rpx;
  color: #666;
  margin-right: 30rpx;
  margin-bottom: 8rpx;
}

.student-actions {
  display: flex;
  flex-direction: column;
}

.action-btn {
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
  text-align: center;
}

.action-btn.edit {
  color: #4CAF50;
  background: #e8f5e9;
}

.action-btn.delete {
  color: #f44336;
  background: #ffebee;
}

.empty-state {
  padding: 100rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.empty-tip {
  font-size: 26rpx;
  color: #ccc;
}