<view class="container">
  <!-- 添加按钮 -->
  <view class="action-bar">
    <button class="btn btn-primary" bindtap="addStudent">+ 添加孩子</button>
  </view>

  <!-- 学生列表 -->
  <view class="student-list">
    <block wx:if="{{studentList.length > 0}}">
      <view class="student-item" wx:for="{{studentList}}" wx:key="id">
        <view class="student-info">
          <view class="student-header">
            <text class="student-name">{{item.studentName}}</text>
            <text class="student-no" wx:if="{{item.studentNo}}">学号: {{item.studentNo}}</text>
          </view>
          <view class="student-detail">
            <text class="detail-item">班级: {{item.className || '未分配'}}</text>
            <text class="detail-item" wx:if="{{item.gender !== null}}">性别: {{item.gender === 1 ? '男' : '女'}}</text>
            <text class="detail-item" wx:if="{{item.birthDate}}">生日: {{item.birthDate}}</text>
          </view>
        </view>
        <view class="student-actions">
          <text class="action-btn edit" bindtap="editStudent" data-id="{{item.id}}">编辑</text>
          <text class="action-btn delete" bindtap="deleteStudent" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="empty-state">
        <text class="empty-text">暂无孩子信息</text>
        <text class="empty-tip">点击上方按钮添加孩子</text>
      </view>
    </block>
  </view>
</view>