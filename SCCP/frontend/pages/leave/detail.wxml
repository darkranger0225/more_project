<view class="container">
  <view class="leave-card">
    <!-- 状态 -->
    <view class="status-section">
      <text class="status-badge status-{{leave.status}}">
        {{leave.status === 'PENDING' ? '待审批' : (leave.status === 'APPROVED' ? '已通过' : '已拒绝')}}
      </text>
    </view>

    <!-- 学生信息 -->
    <view class="info-section">
      <view class="info-item">
        <text class="info-label">学生姓名</text>
        <text class="info-value">{{leave.studentName}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">请假类型</text>
        <text class="info-value">{{leave.leaveType === 'SICK' ? '病假' : (leave.leaveType === 'PERSONAL' ? '事假' : '其他')}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">开始日期</text>
        <text class="info-value">{{leave.startDate}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">结束日期</text>
        <text class="info-value">{{leave.endDate}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">请假天数</text>
        <text class="info-value">{{leave.days}} 天</text>
      </view>
    </view>

    <!-- 请假原因 -->
    <view class="reason-section">
      <text class="section-title">请假原因</text>
      <text class="reason-content">{{leave.reason}}</text>
    </view>

    <!-- 审批信息 -->
    <view class="approve-section" wx:if="{{leave.status !== 'PENDING'}}">
      <text class="section-title">审批信息</text>
      <view class="info-item">
        <text class="info-label">审批人</text>
        <text class="info-value">{{leave.approverName || '-'}}</text>
      </view>
      <view class="info-item" wx:if="{{leave.approveRemark}}">
        <text class="info-label">审批备注</text>
        <text class="info-value">{{leave.approveRemark}}</text>
      </view>
    </view>

    <!-- 申请时间 -->
    <view class="time-section">
      <text class="time-text">申请时间: {{leave.createTime}}</text>
    </view>
  </view>

  <!-- 撤销按钮（仅待审批状态显示） -->
  <view class="action-section" wx:if="{{leave.status === 'PENDING' && role === 'PARENT'}}">
    <button class="btn btn-danger cancel-btn" bindtap="cancelLeave">撤销申请</button>
  </view>
</view>
