/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
  background-color: #f5f5f5;
}

.container {
  padding: 20rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #1890ff;
  padding-left: 20rpx;
}

/* 按钮样式 */
.btn-primary {
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.btn-primary::after {
  border: none;
}

.btn-danger {
  background: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.btn-danger::after {
  border: none;
}

/* 表单样式 */
.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.form-label {
  width: 180rpx;
  font-size: 30rpx;
  color: #666;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

/* 列表样式 */
.list-item {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-item:last-child {
  border-bottom: none;
}

/* 文本样式 */
.text-primary {
  color: #1890ff;
}

.text-danger {
  color: #ff4d4f;
}

.text-success {
  color: #52c41a;
}

.text-warning {
  color: #faad14;
}

.text-gray {
  color: #999;
}

/* 金额样式 */
.amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.amount-small {
  font-size: 36rpx;
  color: #ff4d4f;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 28rpx;
  color: #999;
}
