.container {
  padding: 20rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.detail-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
}

.status-0 {
  color: #ff4d4f;
  background: #fff1f0;
}

.status-1 {
  color: #faad14;
  background: #fffbe6;
}

.status-2 {
  color: #52c41a;
  background: #f6ffed;
}

.detail-content {
  margin-bottom: 30rpx;
}

.content-text {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
}

.detail-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.detail-time {
  font-size: 26rpx;
  color: #999;
}

.reply-content {
  padding: 20rpx 0;
}

.reply-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.handler-info {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.handler-time {
  font-size: 26rpx;
  color: #999;
}
