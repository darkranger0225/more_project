.container {
  padding: 20rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  color: #666;
}

.value {
  font-size: 30rpx;
  color: #333;
}

.amount {
  color: #ff4d4f;
  font-weight: bold;
}

.unpaid {
  color: #ff4d4f;
}

.paid {
  color: #52c41a;
}
