<view class="container">
  <view class="form-container">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" type="text" placeholder="请输入姓名" value="{{userInfo.name}}" bindinput="onNameInput" />
    </view>

    <view class="form-item">
      <text class="form-label">性别</text>
      <picker class="form-picker" bindchange="bindGenderChange" value="{{userInfo.gender}}" range="{{['未知', '男', '女']}}">
        <view class="picker-text">{{['未知', '男', '女'][userInfo.gender]}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">年龄</text>
      <input class="form-input" type="number" placeholder="请输入年龄" value="{{userInfo.age}}" bindinput="onAgeInput" />
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" value="{{userInfo.phone}}" bindinput="onPhoneInput" maxlength="11" />
    </view>

    <view class="form-item read-only">
      <text class="form-label">楼栋</text>
      <text class="form-text">{{userInfo.buildingInfo || '未分配'}}</text>
    </view>

    <view class="form-item read-only">
      <text class="form-label">宿舍</text>
      <text class="form-text">{{userInfo.dormitoryNumber || '未分配'}}</text>
    </view>

    <button class="btn-save" bindtap="saveUserInfo">保存修改</button>
  </view>
</view>
