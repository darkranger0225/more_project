.container {
  padding: 20rpx;
}

.form-container {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.read-only {
  background: #f5f5f5;
  margin: 0 -40rpx;
  padding: 30rpx 40rpx;
}

.form-label {
  width: 160rpx;
  font-size: 30rpx;
  color: #666;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
  height: 60rpx;
  line-height: 60rpx;
}

.form-picker {
  flex: 1;
  text-align: right;
}

.picker-text {
  font-size: 30rpx;
  color: #333;
  height: 60rpx;
  line-height: 60rpx;
}

.form-text {
  flex: 1;
  font-size: 30rpx;
  color: #999;
  text-align: right;
}

.btn-save {
  background: #1890ff;
  color: #fff;
  border-radius: 40rpx;
  margin-top: 60rpx;
}

.btn-save::after {
  border: none;
}
