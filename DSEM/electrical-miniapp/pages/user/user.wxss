.container {
  padding: 20rpx;
}

.user-card {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 20rpx;
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.user-role {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.account-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.account-info {
  display: flex;
  flex-direction: column;
}

.account-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.account-amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.recharge-btn {
  background: #1890ff;
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.menu-list {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 32rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #999;
}

.btn-logout {
  background: #ff4d4f;
  color: #fff;
  border-radius: 40rpx;
}

.btn-logout::after {
  border: none;
}
