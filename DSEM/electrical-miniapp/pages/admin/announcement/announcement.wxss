.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头部 */
.header {
  margin-bottom: 20rpx;
}

.btn-primary {
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background-color: #096dd9;
}

/* 公告列表 */
.announcement-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.announcement-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.announcement-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.announcement-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-enabled {
  background-color: #f6ffed;
  color: #52c41a;
  border: 2rpx solid #b7eb8f;
}

.status-disabled {
  background-color: #f5f5f5;
  color: #999;
  border: 2rpx solid #d9d9d9;
}

.announcement-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.image-list {
  margin-bottom: 20rpx;
}

.announcement-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

.announcement-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #666;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.btn-edit {
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-edit::after {
  border: none;
}

.btn-edit:active {
  background-color: #096dd9;
}

.btn-delete {
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-delete::after {
  border: none;
}

.btn-delete:active {
  background-color: #ff7875;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sub-text {
  font-size: 26rpx;
  color: #bbb;
}
