.container {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding: 20rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  padding: 40rpx;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.avatar text {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
}

.header-info {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.form-section {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-section:last-of-type {
  border-bottom: none;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1890ff;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #fafafa;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #1890ff;
  background-color: #fff;
  box-shadow: 0 0 0 4rpx rgba(24, 144, 255, 0.1);
}

.radio-group {
  display: flex;
  gap: 30rpx;
}

.radio-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  background-color: #fafafa;
  transition: all 0.3s ease;
}

.radio-item text {
  font-size: 28rpx;
  color: #666;
}

.radio-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.radio-active {
  border-color: #1890ff;
  background-color: #e6f7ff;
}

.radio-active text {
  color: #1890ff;
  font-weight: 500;
}

.btn-submit {
  width: calc(100% - 60rpx);
  height: 90rpx;
  margin: 30rpx;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.btn-submit::after {
  border: none;
}

.btn-submit:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.2);
}