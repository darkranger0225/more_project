<view class="container">
  <view class="form-card">
    <view class="card-header">
      <view class="avatar">
        <text>{{studentName ? studentName[0] : '学'}}</text>
      </view>
      <view class="header-info">
        <text class="header-title">{{studentName || '未命名'}}</text>
        <text class="header-subtitle">{{account}}</text>
      </view>
    </view>
    
    <view class="form-section">
      <view class="section-title">基本信息</view>
      
      <view class="form-item">
        <text class="form-label">姓名</text>
        <input class="form-input" type="text" placeholder="请输入姓名" model:value="{{name}}" />
      </view>
      
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" placeholder="请输入手机号" model:value="{{phone}}" />
      </view>
      
      <view class="form-item">
        <text class="form-label">性别</text>
        <view class="radio-group">
          <view class="radio-item {{gender === '1' ? 'radio-active' : ''}}" bindtap="selectGender" data-value="1">
            <text class="radio-icon">👨</text>
            <text>男</text>
          </view>
          <view class="radio-item {{gender === '0' ? 'radio-active' : ''}}" bindtap="selectGender" data-value="0">
            <text class="radio-icon">👩</text>
            <text>女</text>
          </view>
        </view>
      </view>
      
      <view class="form-item">
        <text class="form-label">年龄</text>
        <input class="form-input" type="number" placeholder="请输入年龄" model:value="{{age}}" />
      </view>
    </view>
    
    <view class="form-section">
      <view class="section-title">密码设置</view>
      
      <view class="form-item">
        <text class="form-label">新密码</text>
        <input class="form-input" type="password" placeholder="不修改请留空" model:value="{{newPassword}}" />
      </view>
      
      <view class="form-item">
        <text class="form-label">确认密码</text>
        <input class="form-input" type="password" placeholder="再次输入新密码" model:value="{{confirmPassword}}" />
      </view>
    </view>
    
    <view class="form-section">
      <view class="section-title">账号状态</view>
      
      <view class="form-item">
        <text class="form-label">状态</text>
        <switch checked="{{status === 1}}" bindchange="toggleStatus" color="#1890ff" />
      </view>
    </view>
    
    <button class="btn-submit" bindtap="handleSubmit">保存修改</button>
  </view>
</view>