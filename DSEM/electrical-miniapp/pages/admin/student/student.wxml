<view class="container">
  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索学生账号或姓名" model:value="{{searchText}}" bindinput="onSearch" />
    </view>
  </view>
  
  <!-- 学生列表 -->
  <view class="student-list">
    <view class="student-card" wx:for="{{students}}" wx:key="id">
      <view class="card-header">
        <view class="student-avatar">
          <text>{{item.name ? item.name[0] : '学'}}</text>
        </view>
        <view class="student-basic">
          <text class="student-name">{{item.name || '未命名'}}</text>
          <text class="student-account">{{item.account}}</text>
        </view>
        <view class="student-status {{item.status === 1 ? 'status-active' : 'status-inactive'}}">
          {{item.status === 1 ? '正常' : '禁用'}}
        </view>
      </view>
      
      <view class="card-body">
        <view class="info-item">
          <text class="info-label">📱 手机号</text>
          <text class="info-value">{{item.phone || '未绑定'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">🏠 宿舍</text>
          <text class="info-value">{{item.floorNumber ? item.floorNumber + ' ' : ''}}{{item.dormitoryNumber || '未分配'}}</text>
        </view>
      </view>
      
      <view class="card-footer">
        <view class="action-btn btn-edit" bindtap="editStudent" data-id="{{item.id}}">
          <text class="btn-icon">✏️</text>
          <text>编辑</text>
        </view>
        <view class="action-btn btn-reset" bindtap="resetPassword" data-id="{{item.id}}">
          <text class="btn-icon">🔑</text>
          <text>重置密码</text>
        </view>
        <view class="action-btn btn-delete" bindtap="deleteStudent" data-id="{{item.id}}">
          <text class="btn-icon">🗑️</text>
          <text>删除</text>
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:if="{{students.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无学生数据</text>
    </view>
  </view>
</view>