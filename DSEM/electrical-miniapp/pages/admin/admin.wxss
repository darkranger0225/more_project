.container {
  padding: 20rpx;
}

.admin-header {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.admin-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.admin-role {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 12rpx;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
  width: 100%;
  box-sizing: border-box;
}

.menu-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.menu-item:nth-child(odd) {
  border-right: 1rpx solid #f0f0f0;
}

.menu-item:nth-last-child(-n+2) {
  border-bottom: none;
}

.menu-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
}
