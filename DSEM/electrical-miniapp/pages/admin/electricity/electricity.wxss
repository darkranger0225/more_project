.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #1890ff;
  padding-left: 20rpx;
}

/* 电价设置 */
.price-setting {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.price-setting .label {
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
}

.price-input {
  width: 150rpx;
  height: 70rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.unit {
  font-size: 28rpx;
  color: #666;
  margin: 0 20rpx;
}

.btn-small {
  padding: 0 30rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 搜索区域 */
.search-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.search-item {
  display: flex;
  align-items: center;
}

.search-item .label {
  font-size: 28rpx;
  color: #666;
  width: 140rpx;
  flex-shrink: 0;
}

.picker {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #fff;
}

.search-input {
  flex: 1;
  height: 70rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.btn-primary {
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background-color: #096dd9;
}

/* 宿舍列表 */
.dormitory-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dormitory-item {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 2rpx solid #e8e8e8;
}

.dormitory-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e8e8e8;
}

.dormitory-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.status {
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  height: 56rpx;
  box-sizing: border-box;
}

.status-paid {
  background-color: #f6ffed;
  color: #52c41a;
  border: 2rpx solid #b7eb8f;
}

.status-unpaid {
  background-color: #fff2f0;
  color: #ff4d4f;
  border: 2rpx solid #ffccc7;
}

.dormitory-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #666;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.text-success {
  color: #52c41a;
}

.text-danger {
  color: #ff4d4f;
}

/* 缴费信息 */
.payment-info {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #ddd;
}

.payment-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.payment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.payment-item {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  border: 2rpx solid #e8e8e8;
}

.payment-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.payment-row:last-child {
  margin-bottom: 0;
}

.payment-label {
  font-size: 24rpx;
  color: #666;
}

.payment-value {
  font-size: 24rpx;
  color: #333;
}

.no-payment {
  margin-top: 16rpx;
  padding: 30rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  background-color: #fff;
  border-radius: 8rpx;
  border: 2rpx dashed #ddd;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
