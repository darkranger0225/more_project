.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.announcement-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.announcement-header {
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.announcement-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  display: block;
  margin-bottom: 20rpx;
}

.announcement-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.publisher {
  font-size: 26rpx;
  color: #666;
}

.time {
  font-size: 26rpx;
  color: #999;
}

.announcement-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 30rpx;
}

.image-container {
  margin-top: 30rpx;
}

.announcement-image {
  width: 100%;
  border-radius: 8rpx;
}
