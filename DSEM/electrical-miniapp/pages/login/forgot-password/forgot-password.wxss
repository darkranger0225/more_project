.forgot-password-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  background-color: #f5f5f5;
}

.logo {
  margin-top: 80rpx;
  margin-bottom: 60rpx;
  text-align: center;
}

.logo-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.form-container {
  flex: 1;
  background-color: white;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e6e6e6;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #1890ff;
  outline: none;
}

.btn-submit {
  width: 100%;
  height: 80rpx;
  background-color: #1890ff;
  color: white;
  font-size: 30rpx;
  border-radius: 8rpx;
  margin-top: 40rpx;
}

.btn-submit::after {
  border: none;
}

.login-link {
  text-align: center;
  margin-top: 30rpx;
}

.login-link text {
  font-size: 26rpx;
  color: #1890ff;
}

.login-link text:hover {
  text-decoration: underline;
}