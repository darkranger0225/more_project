<view class="forgot-password-container">
  <view class="logo">
    <text class="logo-text">忘记密码</text>
  </view>
  
  <view class="form-container">
    <view class="form-item">
      <text class="form-label">账号</text>
      <input class="form-input" type="text" placeholder="请输入账号" model:value="{{account}}" />
    </view>
    
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入注册时的手机号" model:value="{{phone}}" />
    </view>
    
    <view class="form-item">
      <text class="form-label">新密码</text>
      <input class="form-input" type="password" placeholder="请输入新密码（至少6位）" model:value="{{newPassword}}" />
    </view>
    
    <view class="form-item">
      <text class="form-label">确认密码</text>
      <input class="form-input" type="password" placeholder="请再次输入新密码" model:value="{{confirmPassword}}" />
    </view>
    
    <button class="btn-submit" bindtap="handleSubmit">提交</button>
    
    <view class="login-link">
      <text bindtap="goToLogin">返回登录</text>
    </view>
  </view>
</view>