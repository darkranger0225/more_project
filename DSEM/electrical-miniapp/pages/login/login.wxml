<view class="login-container">
  <view class="logo">
    <text class="logo-text">电费管理系统</text>
  </view>
  
  <view class="form-container">
    <view class="form-item">
      <text class="form-label">账号</text>
      <input class="form-input" type="text" placeholder="请输入账号" model:value="{{account}}" />
    </view>
    
    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="form-input" type="password" placeholder="请输入密码" model:value="{{password}}" />
    </view>
    
    <button class="btn-login" bindtap="handleLogin">登录</button>
    
    <view class="login-footer">
      <view class="register-link">
        <text bindtap="goToRegister">还没有账号？立即注册</text>
      </view>
      <view class="forgot-password">
        <text bindtap="goToForgotPassword">忘记密码？</text>
      </view>
    </view>
  </view>
</view>
