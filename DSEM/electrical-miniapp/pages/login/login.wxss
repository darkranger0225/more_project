.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #59618f 0%, #10bddb 100%);
  padding: 100rpx 40rpx;
}

.logo {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.form-container {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 40rpx;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-input {
  font-size: 32rpx;
  color: #333;
  height: 60rpx;
}

.btn-login {
  background: #1890ff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 36rpx;
  margin-top: 60rpx;
  height: 90rpx;
  line-height: 60rpx;
}

.btn-login::after {
  border: none;
}

.login-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  font-size: 28rpx;
}

.register-link {
  color: #1890ff;
}

.forgot-password {
  color: #1890ff;
}
