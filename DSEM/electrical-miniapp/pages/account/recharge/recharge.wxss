.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.balance-card {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 20rpx;
  padding: 60rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.balance-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 20rpx;
}

.balance-amount {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
}

.recharge-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.amount-input-wrapper {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #e8e8e8;
  padding: 20rpx 0;
  margin-bottom: 40rpx;
}

.currency {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.amount-input {
  flex: 1;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  height: 80rpx;
}

.quick-amounts {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
  margin-bottom: 40rpx;
}

.amount-btn {
  width: calc(25% - 20rpx);
  margin: 10rpx;
  padding: 24rpx 0;
  text-align: center;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  background: #fff;
}

.amount-btn.active {
  border-color: #1890ff;
  color: #1890ff;
  background: #e6f7ff;
}

.btn-recharge {
  background: #1890ff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 36rpx;
  height: 90rpx;
  line-height: 90rpx;
}

.btn-recharge::after {
  border: none;
}

/* 支付确认弹窗 */
.pay-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.modal-content {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  width: 85%;
  max-width: 600rpx;
  overflow: hidden;
  z-index: 1001;
}

/* 弹窗头部 */
.pay-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.pay-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 48rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 50%;
}

/* 弹窗主体 */
.pay-body {
  padding: 40rpx;
}

/* 金额区域 */
.pay-amount-section {
  text-align: center;
  padding: 40rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.pay-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.pay-amount {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  color: #ff4d4f;
}

/* 信息区域 */
.pay-info-section {
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.pay-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 倒计时区域 */
.pay-timer {
  display: flex;
  justify-content: center;
  padding: 40rpx 0 20rpx;
}

.timer-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #1890ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #e6f7ff;
}

.timer-number {
  font-size: 56rpx;
  font-weight: bold;
  color: #1890ff;
  line-height: 1;
}

.timer-text {
  font-size: 20rpx;
  color: #1890ff;
  margin-top: 8rpx;
}

/* 弹窗底部 */
.pay-footer {
  padding: 30rpx 40rpx 40rpx;
  background: #fafafa;
}

.btn-confirm-pay {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.3);
}

.btn-confirm-pay::after {
  border: none;
}

.btn-text {
  font-weight: 500;
}
