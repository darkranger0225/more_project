<view class="register-container">
  <view class="form-container">
    <view class="form-item">
      <text class="form-label">账号</text>
      <input class="form-input" type="text" placeholder="请输入账号（3-20位）" bindinput="onAccountInput" value="{{account}}" />
    </view>

    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="form-input" type="password" placeholder="请输入密码（至少6位）" bindinput="onPasswordInput" value="{{password}}" />
      <view class="password-strength" wx:if="{{passwordStrength}}">
        <text style="color: {{passwordStrengthColor}};">密码强度：{{passwordStrength}}</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" type="text" placeholder="请输入姓名" bindinput="onNameInput" value="{{name}}" />
    </view>

    <view class="form-item">
      <text class="form-label">楼栋</text>
      <picker bindchange="bindBuildingChange" value="{{buildingIndex}}" range="{{buildingList}}" range-key="buildingNumber">
        <view class="picker">
          {{buildingList[buildingIndex] ? buildingList[buildingIndex].buildingNumber + '' : '请选择楼栋'}}
        </view>
      </picker>
    </view>

    <view class="form-item" wx:if="{{buildingId}}">
      <text class="form-label">楼层</text>
      <picker bindchange="bindFloorChange" value="{{floorIndex}}" range="{{floorList}}" range-key="floorNumber">
        <view class="picker">
          {{floorList[floorIndex] ? floorList[floorIndex].floorNumber : '请选择楼层'}}
        </view>
      </picker>
    </view>

    <view class="form-item" wx:if="{{floorId}}">
      <text class="form-label">宿舍</text>
      <picker bindchange="bindDormitoryChange" value="{{dormitoryIndex}}" range="{{dormitoryList}}" range-key="dormitoryNumber">
        <view class="picker">
          {{dormitoryList[dormitoryIndex] ? dormitoryList[dormitoryIndex].dormitoryNumber + '宿舍' : '请选择宿舍'}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">性别</text>
      <picker bindchange="bindGenderChange" value="{{gender}}" range="{{genderList}}">
        <view class="picker">
          {{genderList[gender]}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">年龄</text>
      <input class="form-input" type="number" placeholder="请输入年龄" bindinput="onAgeInput" value="{{age}}" />
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" bindinput="onPhoneInput" value="{{phone}}" />
    </view>

    <button class="btn-register" bindtap="handleRegister">注册</button>

    <view class="login-link">
      <text bindtap="goToLogin">已有账号？立即登录</text>
    </view>
  </view>
</view>
