.register-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 40rpx;
}

.form-container {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 30rpx;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-input {
  font-size: 32rpx;
  color: #333;
  height: 60rpx;
}

.picker {
  font-size: 32rpx;
  color: #333;
  height: 60rpx;
  line-height: 60rpx;
}

.password-strength {
  margin-top: 10rpx;
  font-size: 26rpx;
}

.btn-register {
  background: #52c41a;
  color: #fff;
  border-radius: 40rpx;
  font-size: 36rpx;
  margin-top: 60rpx;
  height: 90rpx;
  line-height: 90rpx;
}

.btn-register::after {
  border: none;
}

.login-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #1890ff;
}
