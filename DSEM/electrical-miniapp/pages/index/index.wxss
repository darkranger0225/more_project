.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.user-detail {
  margin-left: 20rpx;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
}

.user-dormitory {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.balance-info {
  text-align: right;
}

.balance-label {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
}

.balance-amount {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-top: 8rpx;
}

/* 公告列表 */
.announcement-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.announcement-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.announcement-item:last-child {
  border-bottom: none;
}

.announcement-title {
  font-size: 30rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.announcement-time {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  border-left: 8rpx solid #1890ff;
  padding-left: 20rpx;
}

/* 趋势标签 */
.trend-tabs {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 4rpx;
}

.tab {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 6rpx;
  transition: all 0.3s;
}

.tab.active {
  background-color: #1890ff;
  color: #fff;
}

/* 统计摘要 */
.trend-summary {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
}

.summary-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 图表容器 */
.chart-container {
  width: 100%;
  height: 400rpx;
  position: relative;
}

.trend-chart {
  width: 100%;
  height: 100%;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-text {
  display: block;
}
