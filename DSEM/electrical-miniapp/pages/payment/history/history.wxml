<view class="container">
  <view class="card">
    <view class="card-title">缴费记录</view>
    <view class="history-list">
      <view class="history-item" wx:for="{{historyList}}" wx:key="id">
        <view class="history-info">
          <text class="history-no">{{item.billNo}}</text>
          <text class="history-time">{{item.paymentTime}}</text>
        </view>
        <text class="history-amount">¥{{item.amount}}</text>
      </view>
      <view class="empty-state" wx:if="{{historyList.length === 0}}">
        <text class="empty-text">暂无缴费记录</text>
      </view>
    </view>
  </view>
</view>
