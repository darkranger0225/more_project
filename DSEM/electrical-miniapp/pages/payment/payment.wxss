.container {
  padding: 20rpx;
}

.balance-header {
  text-align: center;
  padding: 30rpx 0;
}

.balance-title {
  display: block;
  font-size: 30rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.balance-value {
  display: block;
  font-size: 62rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.btn-pay-all {
  background: #ff4d4f;
  color: #fff;
  border-radius: 40rpx;
  margin-top: 20rpx;
}

.btn-pay-all::after {
  border: none;
}

.bill-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.bill-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.bill-item:last-child {
  border-bottom: none;
}

.bill-info {
  display: flex;
  flex-direction: column;
}

.bill-time {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.bill-usage {
  font-size: 26rpx;
  color: #666;
}

.bill-action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
  margin-bottom: 12rpx;
}

.btn-pay {
  background: #1890ff;
  color: #fff;
  font-size: 24rpx;
}

.btn-pay::after {
  border: none;
}

.history-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-no {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}

.history-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #52c41a;
}
