/* 页面容器 */
.guide-container {
  min-height: 100vh;
  background-color: #f8f8f8;
}

/* 导航栏样式 */
.navbar {
  padding: 20rpx 30rpx;
  background: linear-gradient(to right, #ff6b8b, #ff8e8e);
  color: #fff;
}

.nav-content {
  display: flex;
  justify-content: center;
  align-items: center;
}

.nav-title-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
}

.nav-subtitle {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

/* 主要内容区域 */
.main-content {
  padding: 30rpx;
}

/* 欢迎区域 */
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.welcome-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.welcome-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: #666;
}

/* 功能说明区域 */
.guide-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #f0f0f0;
}

.section-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-content {
  padding: 10rpx 0;
}

.guide-item {
  margin-bottom: 24rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b8b;
  margin-bottom: 8rpx;
  display: block;
}

.item-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: block;
}

/* 提示列表 */
.tips-list {
  padding: 10rpx 0;
}

.tip-item {
  display: flex;
  margin-bottom: 16rpx;
}

.tip-dot {
  color: #ff6b8b;
  margin-right: 10rpx;
  font-size: 28rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
} 