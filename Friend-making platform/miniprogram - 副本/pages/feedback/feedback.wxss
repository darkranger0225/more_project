/* pages/feedback/feedback.wxss */
.container {
  padding: 0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  text-align: center;
}

.form-item {
  width: 90%;
  margin-bottom: 30rpx;
  padding: 0 20rpx;
}

.label {
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.radio {
  margin-right: 150rpx;
  display: inline-block;
  margin-bottom: 20rpx;
}

.content {
  width: 100%;
  height: 400rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin: 0 auto;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.submit-btn {
  margin-top: 40rpx;
  width: 90%;
}

.success-tips {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
}

.success-text {
  font-size: 36rpx;
  font-weight: bold;
  margin: 30rpx 0;
}

.success-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.back-btn {
  width: 60%;
}

.error-tips {
  color: #f00;
  font-size: 28rpx;
  margin: 20rpx 0;
  text-align: center;
}

.history {
  width: 90%;
  margin-top: 60rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 15rpx;
  margin-bottom: 20rpx;
}

.history-item {
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.history-type {
  font-weight: bold;
}

.history-status {
  font-size: 24rpx;
}

.status-resolved {
  color: #07c160;
}

.status-processing {
  color: #1989fa;
}

.status-pending {
  color: #ff976a;
}

.history-content {
  font-size: 28rpx;
  padding: 10rpx 0;
}

.history-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.history-response {
  margin-top: 20rpx;
  background: #fff;
  padding: 15rpx;
  border-radius: 6rpx;
}

.response-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1989fa;
}

.response-content {
  font-size: 28rpx;
  padding: 10rpx 0;
}

.response-time {
  font-size: 24rpx;
  color: #999;
}

.history-btn {
  margin: 40rpx auto;
  width: 60%;
  font-size: 28rpx;
  padding: 10rpx 0;
} 