.container {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f9f9f9;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.form-description {
  font-size: 28rpx;
  color: #666;
}

.form-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 60rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 10rpx;
}

.form-item {
  margin-bottom: 10rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  background-color: #fafafa;
}

.form-picker {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  background-color: #fafafa;
}

.picker {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  color: #333;
}

.error-container {
  height: 40rpx;
  margin-top: 10rpx;
}

.error-message {
  color: #e64340;
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 20rpx 0 40rpx;
}

.btn-section {
  width: 70%;
  padding-top: 10rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: #1aad19;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 8rpx rgba(26, 173, 25, 0.1);
}

.back-btn {
  width: 100%;
  height: 88rpx;
  background: #f8f8f8;
  color: #666;
  font-size: 32rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 添加输入框和按钮的激活状态样式 */
.form-input:focus, .form-picker:active {
  border-color: #1aad19;
}

.submit-btn:active {
  opacity: 0.9;
}

.back-btn:active {
  background: #f0f0f0;
}