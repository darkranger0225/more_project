<view class="container">

  <view class="form-item">
    <label>用户ID：</label>
    <input name="userID" value="{{userId}}" disabled class="disabled-input" />
  </view>
  
  <!-- 基本信息 -->
  <view class="form-item">
    <label>姓名：</label>
    <input 
      type="text" 
      data-field="name"
      value="{{formData.name}}"
      bindinput="bindInput" 
      placeholder="请输入姓名" 
      class="form-input"
    />
  </view>
  
  <view class="form-item">
    <label>密码：</label>
    <input 
      type="password" 
      data-field="password"
      value="{{formData.password}}"
      bindinput="bindInput" 
      placeholder="不修改请留空" 
      class="form-input"
    />
  </view>
  <view class="error-container">
    <text class="error-message">{{passwordError}}</text>
  </view>
  
  <view class="form-item">
    <label>生日：</label>
    <picker 
      mode="date" 
      value="{{formData.birthday}}" 
      bindchange="onBirthdayChange"
      class="form-picker"
    >
      <view class="picker">{{formData.birthday || '请选择生日'}}</view>
    </picker>
  </view>
  
  <view class="form-item">
    <label>地址：</label>
    <picker 
      mode="region" 
      value="{{addressArray}}" 
      bindchange="onAddressChange"
      class="form-picker"
    >
      <view class="picker">{{formData.address || '请选择省/市/区县'}}</view>
    </picker>
  </view>
  
  <view class="form-item">
    <label>性别：</label>
    <picker 
      mode="selector" 
      range="{{sexOptions}}" 
      value="{{sexIndex}}" 
      bindchange="onSexChange"
      class="form-picker"
    >
      <view class="picker">{{sexOptions[sexIndex]}}</view>
    </picker>
  </view>

  <!-- 可选字段 -->
  <view class="form-item">
    <label>学校：</label>
    <input 
      type="text" 
      data-field="school"
      value="{{formData.school}}"
      bindinput="bindInput" 
      placeholder="请输入学校" 
      class="form-input"
    />
  </view>
  
  <view class="form-item">
    <label>QQ号：</label>
    <input 
      type="number" 
      data-field="qq"
      value="{{formData.qq}}"
      bindinput="bindInput" 
      placeholder="请输入QQ号" 
      class="form-input"
    />
  </view>
  
  <view class="form-item">
    <label>微信号：</label>
    <input 
      type="text" 
      data-field="wechat"
      value="{{formData.wechat}}"
      bindinput="bindInput" 
      placeholder="请输入微信号" 
      class="form-input"
    />
  </view>

  <view class="form-item">
    <label>个人简介：</label>
    <textarea 
      data-field="bio"
      value="{{formData.bio}}"
      bindinput="bindInput" 
      placeholder="请输入个人简介" 
      class="form-textarea"
      maxlength="500"
    />
  </view>

  <!-- 提交按钮 -->
  <button class="submit-btn" bindtap="update">提交修改</button>
  
  <view class="tips">
    <text>提示：如不修改密码，请将密码框留空</text>
  </view>
</view>