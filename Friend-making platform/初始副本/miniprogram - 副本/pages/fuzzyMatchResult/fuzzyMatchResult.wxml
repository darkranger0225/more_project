<view class="container">
  <block wx:if="{{matches && matches.length > 0}}">
    <view class="card" wx:for="{{matches}}" wx:key="userId">
      <view class="card-header">
        <text class="card-title">{{item.name}}</text>
        <text class="card-score">匹配度: {{item.formattedScore}}%</text>
      </view>
      <view class="card-body">
        <view class="card-row">
          <text class="card-label">性格:</text>
          <text class="card-value">{{item.personality}}</text>
        </view>
        <view class="card-row">
          <text class="card-label">爱好:</text>
          <text class="card-value">{{item.interests}}</text>
        </view>
        <view class="card-row">
          <text class="card-label">其他偏好:</text>
          <text class="card-value">{{item.otherPreferences}}</text>
        </view>
      </view>
    </view>
  </block>
  <view wx:else class="empty-container">
    <view class="empty-icon">🌱</view>
    <view class="empty-title">暂无匹配结果</view>
    <view class="empty-desc">尝试填写更多爱好信息，发现与你志同道合的朋友</view>
    <view class="empty-tips">丰富的个人信息能帮助系统找到更适合你的人</view>
  </view>
</view>