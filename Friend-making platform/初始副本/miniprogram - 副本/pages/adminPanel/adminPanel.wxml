<!-- pages/adminPanel/adminPanel.wxml -->
<view class="container">
  <view class="header">
    <view class="title">管理员控制面板</view>
    <view class="subtitle">系统管理与配置</view>
  </view>

  <!-- 功能卡片区域 -->
  <view class="card-section">
    <view class="section-title">系统功能</view>
    <view class="cards">
      <view class="card" bindtap="showResetOptions">
        <view class="card-icon">🔑</view>
        <view class="card-title">密码重置</view>
        <view class="card-desc">重置用户或管理员密码</view>
      </view>
      <view class="card" bindtap="toggleAddForm">
        <view class="card-icon">➕</view>
        <view class="card-title">添加管理员</view>
        <view class="card-desc">创建新的管理员账户</view>
      </view>
      <view class="card" bindtap="showMatchingStats">
        <view class="card-icon">📊</view>
        <view class="card-title">匹配统计</view>
        <view class="card-desc">查看系统匹配数据统计</view>
      </view>
      <view class="card" bindtap="showUserStats">
        <view class="card-icon">👥</view>
        <view class="card-title">用户行为统计</view>
        <view class="card-desc">查看系统用户行为数据</view>
      </view>
      <view class="card" bindtap="showUserInfoSearch">
        <view class="card-icon">🔍</view>
        <view class="card-title">用户信息查询</view>
        <view class="card-desc">查询用户详细信息</view>
      </view>
      <view class="card" bindtap="toggleAdminList">
        <view class="card-icon">👮</view>
        <view class="card-title">管理员列表</view>
        <view class="card-desc">查看所有管理员账户</view>
      </view>
      <view class="card" bindtap="toFeedbackManagement">
        <view class="card-icon">📝</view>
        <view class="card-title">反馈管理</view>
        <view class="card-desc">查看和回复用户反馈</view>
      </view>
    </view>
  </view>

  <!-- 添加管理员表单 -->
  <view class="form-section" wx:if="{{showAddForm}}">
    <view class="section-title">添加管理员</view>
    <view class="form-item">
      <text class="form-label">用户名</text>
      <input class="form-input" placeholder="请输入管理员用户名" value="{{newAdmin.username}}" bindinput="inputChange" data-field="username" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入管理员手机号" value="{{newAdmin.phone}}" bindinput="inputChange" data-field="phone" type="number" />
    </view>
    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="form-input" placeholder="默认为123456" value="{{newAdmin.password}}" bindinput="inputChange" data-field="password" password />
    </view>
    <view class="form-buttons">
      <button class="btn btn-cancel" bindtap="toggleAddForm">取消</button>
      <button class="btn btn-primary" bindtap="addAdmin" loading="{{loading}}">添加</button>
    </view>
  </view>

  <!-- 用户信息查询表单 -->
  <view class="form-section" wx:if="{{showUserInfoSearch}}">
    <view class="section-title">用户信息查询</view>
    <view class="form-item">
      <text class="form-label">用户ID</text>
      <input class="form-input" placeholder="请输入用户ID" value="{{userIdToSearch}}" bindinput="userIdInputChange" type="number" />
    </view>
    <view class="form-buttons">
      <button class="btn btn-cancel" bindtap="hideUserInfoSearch">取消</button>
      <button class="btn btn-primary" bindtap="searchUserInfo" loading="{{loading}}">查询</button>
      <button class="btn btn-warning" bindtap="resetUserPassword" loading="{{loading}}">重置密码</button>
      <button class="btn btn-danger" bindtap="deleteUser" loading="{{loading}}">删除用户</button>
    </view>
  </view>

  <!-- 用户信息展示 -->
  <block wx:if="{{userInfo}}">
    <view class="user-info-section">
      <view class="section-title">用户基本信息</view>
      <view class="user-info-container">
        <view class="user-info-item">
          <text class="info-label">用户ID:</text>
          <text class="info-value">{{userInfo.userId}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">姓名:</text>
          <text class="info-value">{{userInfo.name}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">性别:</text>
          <text class="info-value">{{userInfo.sex === 1 ? '男' : '女'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">生日:</text>
          <text class="info-value">{{userInfo.birthday}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">手机号:</text>
          <text class="info-value">{{userInfo.phone}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">地址:</text>
          <text class="info-value">{{userInfo.address}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">学校:</text>
          <text class="info-value">{{userInfo.school || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">QQ:</text>
          <text class="info-value">{{userInfo.qq || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">微信:</text>
          <text class="info-value">{{userInfo.wechat || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">兴趣爱好:</text>
          <text class="info-value">{{userInfo.interests || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">性格特点:</text>
          <text class="info-value">{{userInfo.personalityTraits || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">其他偏好:</text>
          <text class="info-value">{{userInfo.otherPreferences || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">允许被索引:</text>
          <text class="info-value {{allowIndexing ? 'success-text' : 'error-text'}}">{{allowIndexing ? '是' : '否'}}</text>
        </view>
      </view>
    </view>

    <view class="user-info-section" wx:if="{{preferences}}">
      <view class="section-title">用户期望信息</view>
      <view class="user-info-container">
        <view class="user-info-item">
          <text class="info-label">期望姓名:</text>
          <text class="info-value">{{preferences.preferredName || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">期望生日范围:</text>
          <text class="info-value">{{preferences.preferredBirthdayRange || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">期望地址:</text>
          <text class="info-value">{{preferences.preferredAddress || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">期望手机号:</text>
          <text class="info-value">{{preferences.preferredPhone || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">期望学校:</text>
          <text class="info-value">{{preferences.preferredSchool || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">期望QQ:</text>
          <text class="info-value">{{preferences.preferredQQ || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">期望微信:</text>
          <text class="info-value">{{preferences.preferredWeChat || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">期望兴趣爱好:</text>
          <text class="info-value">{{preferences.preferredInterests || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">期望性格特点:</text>
          <text class="info-value">{{preferences.preferredPersonalityTraits || '未填写'}}</text>
        </view>
        <view class="user-info-item">
          <text class="info-label">其他期望:</text>
          <text class="info-value">{{preferences.otherPreferences || '未填写'}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 统计信息区域 -->
  <view class="stats-section" wx:if="{{showStats}}">
    <view class="section-title">{{statsTitle}}</view>
    <view class="stats-container">
      <view class="stat-card" wx:for="{{statsData}}" wx:key="label">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>
    <view class="no-data" wx:if="{{statsData.length === 0 && !loading}}">暂无统计数据</view>
  </view>

  <!-- 错误和成功消息 -->
  <view class="message error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  <view class="message success" wx:if="{{successMsg}}">{{successMsg}}</view>

  <!-- 管理员列表 -->
  <view class="admin-list-section" wx:if="{{showAdminList}}">
    <view class="section-title">管理员列表</view>
    <view class="admin-list">
      <view class="admin-item" wx:for="{{admins}}" wx:key="id">
        <view class="admin-info">
          <view class="admin-avatar">{{item.username[0]}}</view>
          <view class="admin-details">
            <view class="admin-name">{{item.username}}</view>
            <view class="admin-phone">{{item.phone}}</view>
          </view>
        </view>
        <view class="admin-actions">
          <view class="admin-delete" bindtap="deleteAdmin" data-id="{{item.id}}" data-username="{{item.username}}">删除</view>
        </view>
      </view>
      <view class="no-data" wx:if="{{admins.length === 0 && !loading}}">暂无管理员数据</view>
    </view>
  </view>

  <!-- 加载指示器 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading"></view>
  </view>
</view> 