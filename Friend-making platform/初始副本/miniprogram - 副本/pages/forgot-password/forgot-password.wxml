<view class="container">
  <view class="header">
    <view class="page-title">找回密码</view>
    <view class="form-description">请输入您注册时的信息进行身份验证</view>
  </view>
  
  <view class="form-section">
    <!-- 必填字段 -->
    <view class="form-item">
      <label class="form-label">姓名</label>
      <input 
        type="text" 
        data-field="name" 
        bindinput="bindInput" 
        placeholder="请输入注册时的姓名" 
        class="form-input"
      />
    </view>
    
    <view class="form-item">
      <label class="form-label">手机号</label>
      <input 
        type="number" 
        data-field="phone" 
        bindinput="bindInput" 
        placeholder="请输入注册时的手机号" 
        class="form-input"
      />
      <view class="error-container">
        <text class="error-message">{{phoneError}}</text>
      </view>
    </view>
    
    <view class="form-item">
      <label class="form-label">生日</label>
      <picker 
        mode="date" 
        value="{{birthday}}" 
        bindchange="onBirthdayChange"
        class="form-picker"
      >
        <view class="picker">{{birthday || '请选择注册时填写的生日'}}</view>
      </picker>
    </view>
    
    <view class="divider"></view>
    
    <view class="form-item">
      <label class="form-label">新密码</label>
      <input 
        type="password" 
        data-field="newPassword" 
        bindinput="bindInput" 
        placeholder="请输入新密码（至少6位）" 
        class="form-input"
      />
    </view>
    
    <view class="form-item">
      <label class="form-label">确认密码</label>
      <input 
        type="password" 
        data-field="confirmPassword" 
        bindinput="bindInput" 
        placeholder="请再次输入新密码" 
        class="form-input"
      />
      <view class="error-container">
        <text class="error-message">{{passwordError}}</text>
      </view>
    </view>
  </view>
  
  <view class="btn-section">
    <!-- 重置密码按钮 -->
    <button class="submit-btn" bindtap="resetPassword">重置密码</button>
    
    <!-- 返回登录按钮 -->
    <button class="back-btn" bindtap="navigateBack">返回登录</button>
  </view>
</view>