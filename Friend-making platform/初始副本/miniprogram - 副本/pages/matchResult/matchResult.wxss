.container {
  padding: 12rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 2rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-content {
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 24rpx;
  width: 4rpx;
  background-color: #3a7afe;
  border-radius: 4rpx;
}

.result-box {
  padding: 16rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  border: 1rpx solid #eef0f6;
  margin-bottom: 8rpx;
}

.result-box:last-child {
  margin-bottom: 0;
}

.result-box text {
  display: block;
  line-height: 1.5;
  font-size: 26rpx;
  color: #333;
  word-break: break-word;
  white-space: pre-wrap;
}

.divider {
  height: 1rpx;
  background-color: #eef0f6;
  margin: 8rpx 0;
  width: 100%;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
  color: inherit;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
  text-align: center;
}

.empty-subtext {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  line-height: 1.4;
}