/* 导航栏样式 */
.navbar {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
  background: linear-gradient(to right, #fff5f5, #ffffff);
  box-shadow: 0 2rpx 10rpx rgba(255, 107, 107, 0.1);
}

.nav-content {
  text-align: center;
}

.nav-title-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-title {
  font-size: 48rpx;
  font-weight: bold;
  background: linear-gradient(45deg, #ff6b6b, #ff8e8e);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  line-height: 1.2;
  margin-bottom: 4rpx;
  display: block;
}

.nav-subtitle {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 4rpx;
  display: block;
}

/* 主要内容区域 */
.main-content {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
  background-color: #f8f8f8;
}

/* 欢迎语区域 */
.welcome-section {
  margin-bottom: 40rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #ffffff, #fff5f5);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.05);
}

.welcome-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.sub-text {
  font-size: 28rpx;
  color: #666;
  display: block;
}

/* 功能卡片区域 */
.function-section {
  margin-bottom: 40rpx;
}

.function-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #ffffff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(255, 107, 107, 0.1);
}

.function-card:active {
  transform: scale(0.98);
  background-color: #fff5f5;
}

.card-content {
  display: flex;
  align-items: center;
}

.card-content .card-image {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  display: block;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.card-arrow {
  color: #ff6b6b;
}

.arrow-icon {
  font-size: 36rpx;
  display: block;
}

/* 推荐用户区域 */
.recommend-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.more-link {
  font-size: 24rpx;
  color: #ff6b6b;
  padding: 8rpx 20rpx;
  background-color: rgba(255, 107, 107, 0.1);
  border-radius: 20rpx;
  display: block;
}

.recommend-scroll {
  white-space: nowrap;
  padding: 10rpx 0;
}

.user-card {
  display: inline-block;
  margin-right: 20rpx;
  width: 240rpx;
  height: 300rpx;
  perspective: 1500rpx;
  position: relative;
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  text-align: center;
  transition: transform 0.6s ease;
  transform-style: preserve-3d;
  transform-origin: center center;
}

.user-card.flipped .card-inner {
  transform: rotateY(180deg);
}

.card-front, .card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 107, 107, 0.1);
  box-sizing: border-box;
  overflow: hidden;
}

.card-back {
  transform: rotateY(180deg);
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
}

.card-front .user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
  border: 4rpx solid rgba(255, 107, 107, 0.2);
}

.user-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.user-tag {
  font-size: 24rpx;
  color: #ff4d4f;
  background-color: rgba(255, 77, 79, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: block;
}

.phone-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-label image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

.phone-number {
  width: 100%;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: bold;
  padding: 8rpx 6rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  word-break: break-all;
  word-wrap: break-word;
  text-align: center;
  box-sizing: border-box;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

/* 空状态样式 */
.empty-recommend {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid rgba(255, 107, 107, 0.1);
}

.empty-image {
  width: 260rpx;
  height: 260rpx;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.empty-subtext {
  font-size: 24rpx;
  color: #999;
  display: block;
}

/* 活动区域 */
.activity-section {
  margin-bottom: 40rpx;
}

/* 活动轮播图 */
.activity-swiper {
  height: 240rpx;
  margin-top: 20rpx;
}

.activity-card {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.activity-bg {
  width: 100%;
  height: 100%;
}

.activity-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
  color: #fff;
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.activity-time {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 错误信息提示样式 */
.error-message {
  position: fixed;
  top: -100rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  max-width: 600rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.2);
  z-index: 1000;
  transition: all 0.3s ease;
  opacity: 0;
}

.error-message.show {
  top: 30rpx;
  opacity: 1;
}

.error-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.error-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}