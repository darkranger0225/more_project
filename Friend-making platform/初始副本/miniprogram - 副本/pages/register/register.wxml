<view class="container">
  <!-- 必填字段 -->
  <view class="form-item">
    <label>姓名：</label>
    <input 
      type="text" 
      data-field="name" 
      bindinput="bindInput" 
      placeholder="请输入姓名" 
      class="form-input"
    />
  </view>
  <view class="form-item">
    <label>手机号：</label>
    <input 
      type="number" 
      data-field="phone" 
      bindinput="bindInput" 
      placeholder="请输入手机号" 
      class="form-input"
    />
  </view>
  <view class="error-container">
  <text class="error-message">{{phoneError}}</text> <!-- 错误提示 -->
  </view>
  <view class="form-item">
    <label>密码：</label>
    <input 
      type="password" 
      data-field="passWord" 
      bindinput="bindInput" 
      placeholder="请输入密码（最少6位）" 
      class="form-input"
    />
  </view>
  <view class="error-container">
  <text class="error-message">{{passwordError}}</text> <!-- 错误提示 -->
  </view>
  <view class="form-item">
    <label>生日：</label>
    <picker 
      mode="date" 
      value="{{formData.birthday}}" 
      bindchange="onBirthdayChange"
      class="form-picker"
    >
      <view class="picker">{{formData.birthday || '请选择生日'}}</view>
    </picker>
  </view>
  <view class="form-item">
    <label>地址：</label>
    <picker 
      mode="region" 
      value="{{formData.preferredAddress}}" 
      bindchange="onAddressChange"
      class="form-picker"
    >
      <view class="picker">{{formData.preferredAddress || '请选择省/市/区县'}}</view>
    </picker>
  </view>
  <view class="form-item">
    <label>性别：</label>
    <picker 
      mode="selector" 
      range="{{sexOptions}}" 
      value="{{sexIndex}}" 
      bindchange="onSexChange"
      class="form-picker"
    >
      <view class="picker">{{sexOptions[sexIndex] || '请选择性别'}}</view>
    </picker>
  </view>

  <!-- 可选字段 -->
  <view class="form-item">
    <label>学校：</label>
    <input 
      type="text" 
      data-field="school" 
      bindinput="bindInput" 
      placeholder="请输入学校（可选）" 
      class="form-input"
    />
  </view>
  <view class="form-item">
    <label>QQ号：</label>
    <input 
      type="number" 
      data-field="qq" 
      bindinput="bindInput" 
      placeholder="请输入QQ号（可选）" 
      class="form-input"
    />
  </view>
  <view class="form-item">
    <label>微信号：</label>
    <input 
      type="text" 
      data-field="wechat" 
      bindinput="bindInput" 
      placeholder="请输入微信号（可选）" 
      class="form-input"
    />
  </view>

  <!-- 性格特点选择器 -->
  <view class="form-item">
    <label>性格特点：</label>
    <picker 
      mode="selector" 
      range="{{personalityOptions}}" 
      value="{{personalityIndex}}" 
      bindchange="onPersonalityChange"
      class="form-picker"
    >
      <view class="picker">{{formData.preferredPersonalityTraits || '请选择性格特征（必填）'}}</view>
    </picker>
  </view>

  <!-- 兴趣爱好复选框 -->
  <view class="form-item checkbox-section">
    <label>兴趣爱好：</label>
    <checkbox-group bindchange="onInterestChange" value="{{formData.preferredInterests}}">
      <view class="checkbox-group">
        <block wx:for="{{interestOptions}}" wx:key="index">
          <label class="checkbox-label">
            <checkbox value="{{item}}">{{item}}</checkbox>
          </label>
        </block>
      </view>
    </checkbox-group>
  </view>

  <!-- 其他偏好复选框 -->
  <view class="form-item checkbox-section">
    <label>其他偏好：</label>
    <checkbox-group bindchange="onOtherPreferenceChange" value="{{formData.otherPreferences}}">
      <view class="checkbox-group">
        <block wx:for="{{otherPreferenceOptions}}" wx:key="index">
          <label class="checkbox-label">
            <checkbox value="{{item}}">{{item}}</checkbox>
          </label>
        </block>
      </view>
    </checkbox-group>
  </view>

  <!-- 注册按钮 -->
  <button class="submit-btn" bindtap="register">注册</button>
</view>